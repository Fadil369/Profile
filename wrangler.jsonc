{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile",
  "account_id": "d7b99530559ab4f2545e9bdc72a7ab9b",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "landing/dist",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "elfadil.com/*",
      "zone_name": "elfadil.com"
    },
    {
      "pattern": "www.elfadil.com/*",
      "zone_name": "elfadil.com"
    }
  ]
}
